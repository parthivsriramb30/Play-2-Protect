# ============================================================
# PLAY2PROTECT ENVIRONMENT CONFIGURATION
# Copy this file to .env in the server directory and client directory as needed
# ============================================================

# Server Port
PORT=5000

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (for AI Chatbot)
# Get a free key at: https://aistudio.google.com/
# If left empty, Play2Protect uses an intelligent local rule-based anti-doping engine!
GEMINI_API_KEY=

# Firebase Client Configuration (Optional - Demo mode works automatically if omitted)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=play2protect.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=play2protect
VITE_FIREBASE_STORAGE_BUCKET=play2protect.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
